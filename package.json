{
  "name": "boost-geospatial-index",
  "main": "index.js",
  "version": "1.4.0",
  "author": "The Kuzzle Team <support@kuzzle.io>",
  "description": "A bridge to the C++ boost::geometry library, allowing to index and query geospatial shapes",
  "keywords": [
    "rtree",
    "rstar",
    "geospatial",
    "geoshape",
    "kuzzle"
  ],
  "scripts": {
    "install": "node-gyp-build",
    "configure": "node-gyp configure",
    "build": "node-gyp build",
    "rebuild": "node-gyp rebuild",
    "prebuildify": "prebuildify --napi --strip --tag-libc",
    "lint": "eslint .",
    "test": "node --test test/index.test.js"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/kuzzleio/boost-geospatial-index.git"
  },
  "dependencies": {
    "node-addon-api": "8.5.0",
    "node-gyp-build": "4.8.4"
  },
  "devDependencies": {
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "14.1.0",
    "eslint-plugin-kuzzle": "0.0.15",
    "node-gyp": "12.1.0",
    "prebuildify": "6.0.1",
    "semantic-release": "^25.0.3",
    "semantic-release-config-kuzzle": "1.1.2"
  },
  "engines": {
    "node": ">= 18.0.0"
  },
  "license": "Apache-2.0",
  "files": [
    "CHANGELOG.md",
    "LICENSE.md",
    "README.md",
    "binding.gyp",
    "index.js",
    "include/",
    "prebuilds/",
    "src/"
  ]
}
